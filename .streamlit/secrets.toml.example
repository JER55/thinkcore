# Copia questo file in .streamlit/secrets.toml per lo sviluppo LOCALE
# (quel file è già escluso da .gitignore, non finirà mai su Git).
#
# Su Streamlit Community Cloud NON si carica questo file: si incolla lo
# stesso contenuto in App → Settings → Secrets dalla dashboard.
#
# Se [github] è assente o incompleto, ThinkCore funziona comunque in
# modalità "locale": i 3 CSV di stato restano su disco in /tmp/rotosmart
# e non c'è persistenza tra i riavvii del container cloud.

[github]
# Personal Access Token con permesso "repo" (classic) oppure
# "Contents: Read and write" (fine-grained), limitato al repo sotto.
token = "ghp_INCOLLA_QUI_IL_TUO_TOKEN"

# Repo PRIVATO dedicato SOLO ai CSV di stato (straordinari, riposi,
# storico) — tienilo separato dal repo del codice sorgente, così puoi
# rendere pubblico quest'ultimo senza esporre dati operativi.
repo = "tuo-utente/thinkcore-state"

# Cartella nel repo dove vivono i 3 CSV (verrà creata automaticamente
# al primo salvataggio se non esiste).
path = "data"
